{
  "name": "@thanks-ai/mcp",
  "version": "0.1.0",
  "description": "The Thanks MCP server: one tool, say_thanks, that sends public URLs or package names, an optional public why and the task kind, and nothing else.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "thanks-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aithanksu/thanks-mcp.git"
  },
  "homepage": "https://aithanksu.com",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agents",
    "thanks"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
